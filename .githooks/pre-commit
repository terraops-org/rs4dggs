#!/usr/bin/env bash
# The local gate before every commit that changes the code or a published file. GitHub runs the
# gate too, but without DGGAL's oracle suites, which need the recorded DGGAL build: this hook is
# where each commit is checked against DGGAL.
# Switch it on once per clone:
#   git config core.hooksPath .githooks
#   git config rs4dggs.dggalSitePackages /path/to/site-packages   # the recorded DGGAL build
# The gate with DGGAL also needs `python3` with the module `jsonschema` (pip install jsonschema),
# for its check of zone data against the DGGS-JSON schema; the gate without DGGAL does not.
# `git commit --no-verify` skips it when there is good reason.
set -euo pipefail
root=$(git rev-parse --show-toplevel)

# A commit that touches neither the code nor a published file (notes kept beside the code) needs
# no gate. Anything else does.
published='^(crates/|scripts/|bench/|\.github/|\.githooks/|Cargo\.(toml|lock)$'
published+='|README\.md$|CONTRIBUTING\.md$|LICENSE$|NOTICE$)'
if ! git diff --cached --name-only | grep -qE "$published"; then
  echo "pre-commit: neither the code nor a published file changed; the gate is not run."
  exit 0
fi

if [[ -z "${DGGAL_SITE_PACKAGES:-}" ]]; then
  DGGAL_SITE_PACKAGES=$(git config --get rs4dggs.dggalSitePackages || true)
fi
if [[ -z "${DGGAL_SITE_PACKAGES}" ]]; then
  echo "pre-commit: no DGGAL configured: the gate runs WITHOUT the oracle suites." >&2
  echo "  To include them: git config rs4dggs.dggalSitePackages /path/to/site-packages" >&2
  exec "$root/scripts/check.sh" --without-dggal
fi
export DGGAL_SITE_PACKAGES

# The gate checks the working tree, so changes left unstaged are checked with the staged ones.
echo "pre-commit: running scripts/check.sh (a few minutes)..."
exec "$root/scripts/check.sh"
